---
import type { HTMLAttributes } from "astro/types";
import Clipboard from "../clipboard.astro";
import { cn } from "#/lib/utils";

type Props = HTMLAttributes<"pre">;

const { class: className, dir = "ltr", tabindex, ...props } = Astro.props;
---

<Clipboard
  size="icon"
  class="absolute top-1 right-1 z-10 size-7 rounded-sm"
  value="$el.nextElementSibling.textContent.trim()"
/>
<pre
  {...props}
  {dir}
  {tabindex}
  class={cn("thin-scrollbar overflow-auto p-3.5 pr-12", className)}><slot /></pre>
