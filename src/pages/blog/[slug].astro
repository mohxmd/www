---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { Picture } from "astro:assets";

import Layout from "#/layouts/layout.astro";
import { getSortedPosts, type GetSortedPosts } from "#/content/utils";
import { getPostArcContext } from "#/lib/blog/arc";

import Link from "#/components/ui/link.astro";
import Text from "#/components/ui/text.astro";
import Date from "#/components/ui/date.astro";
import Chip from "#/components/ui/chip.astro";
import Separator from "#/components/ui/separator.astro";
import MarkdownContent from "#/components/content/markdown-content.astro";

import PostComments from "./_components/post-comments.astro";
import PostViews from "./_components/post-views.astro";
import PostNavigator from "./_components/post-navigator.astro";
import PostActions from "./_components/post-actions.astro";
import PostToc from "./_components/post-toc.astro";
import PostOutline from "./_components/post-outline.astro";
import PostArc from "./_components/post-arc.astro";

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

export const prerender = true;

export const getStaticPaths = (async () =>
  (await getSortedPosts()).map((post, index, posts) => {
    const prevPost = (posts[index + 1] ?? posts[0]) as GetSortedPosts[0];
    const nextPost = (posts[index - 1] ?? posts[posts.length - 1]) as GetSortedPosts[0];
    return {
      params: { slug: post.id },
      props: { ...post, morePosts: [prevPost, nextPost] },
    };
  })) satisfies GetStaticPaths;

const { id: postId, data, headings, Content, morePosts } = Astro.props;
const { title, pubDate, updatedDate, image, description, author } = data;
const [prevPost, nextPost] = morePosts;
const arcContext = await getPostArcContext(postId);

const publishDate = pubDate.toLocaleString();
---

<Layout
  metadata={{
    title: `Mohammed's blog | ${title}`,
    description: description,
    og: image.src,
    author,
    type: "blog",
    publishDate: pubDate.toISOString(),
    modifiedDate: (updatedDate ?? pubDate).toISOString(),
  }}
>
  <PostOutline headings={headings} />

  <article itemscope class="pb-6">
    <header class="mb-8 space-y-4">
      <Text as="h1" size="fluid-2xl" class="font-8bit text-center font-bold">
        {title}
      </Text>

      <div
        class="text-muted-foreground text-fluid-sm flex flex-wrap items-center justify-center gap-2"
      >
        <Chip icon="user">Mohammed</Chip>

        <Chip icon="calendar">
          <Date
            value={data.pubDate}
            variant="muted"
            size="xs"
            datetime={publishDate}
            itemprop="datePublished"
          />
        </Chip>

        <Chip icon="clock-4">{data.readingTime}</Chip>

        <Chip icon="eye">
          <PostViews data-post-views={postId} server:defer id={postId} variant="muted" size="xs" />
        </Chip>

        {
          arcContext && (
            <Link href={`/arcs/${arcContext.arc.slug}`}>
              <Chip icon="list">
                {arcContext.arc.entry.data.title} · Part {arcContext.currentIndex + 1}
              </Chip>
            </Link>
          )
        }
      </div>
    </header>

    <PostToc headings={headings} />

    <div class="my-5">
      <Picture
        src={image}
        formats={["avif", "webp"]}
        alt={title}
        width={800}
        height={400}
        loading="eager"
        fetchpriority="high"
        layout="constrained"
        class="border-border aspect-2/1 w-full rounded-lg border object-cover"
      />
    </div>

    <MarkdownContent Content={Content} itemprop="articleBody" />

    <footer class="mt-10 space-y-6">
      <Separator />
      {arcContext && <PostArc context={arcContext} />}
      {arcContext && <Separator />}
      <PostActions />
      <PostNavigator prevPost={prevPost} nextPost={nextPost} />
      <Separator />
      <PostComments />
    </footer>
  </article>
</Layout>
