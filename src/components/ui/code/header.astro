---
import { cn } from "#/lib/utils";
import Icon from "../icon.astro";

import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"figcaption">;

const { class: className, ...props } = Astro.props;
---

<figcaption
  {...props}
  class={cn(
    "bg-muted/80 text-muted-foreground text-fluid-sm flex min-h-9 items-center gap-2 border-b px-3 py-1.5 pr-12 font-mono",
    className
  )}
>
  <Icon name="FileCode" size="sm" class="text-current/70" />
  <span class="truncate"><slot /></span>
</figcaption>
